# Copy this file to .env and fill in real values.
# Nothing here is required to run the core detection/compliance/Flask
# pipeline — only fill in the sections you're ready to wire up.

# --- Model / detection ------------------------------------------------
SAFEVISION_MODEL_PATH=models/best.pt
SAFEVISION_CONF_THRESHOLD=0.40
SAFEVISION_IOU_THRESHOLD=0.45
SAFEVISION_OVERLAP_THRESHOLD=0.30

# --- Class list & compliance rules -------------------------------------
# Comma-separated. Must match dataset/data.yaml's `names:` list & order.
SAFEVISION_CLASSES=Person,Helmet,Safety Vest,Gloves,Face Mask,Goggles,Safety Boots
SAFEVISION_REQUIRED_PPE=Helmet,Safety Vest

# --- Site metadata -------------------------------------------------------
SAFEVISION_LOCATION=Construction Site A

# --- Flask ---------------------------------------------------------------
SAFEVISION_SECRET_KEY=change-me-to-something-random
SAFEVISION_UPLOAD_FOLDER=static/uploads
SAFEVISION_OUTPUT_FOLDER=static/outputs
SAFEVISION_MAX_UPLOAD_MB=50

# --- MongoDB (Module 7) ---------------------------------------------------
SAFEVISION_DB_ENABLED=false
MONGO_URI=
MONGO_DB_NAME=safevision

# --- Email alerts (Module 9) ----------------------------------------------
SAFEVISION_EMAIL_ALERTS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# --- Telegram alerts (Module 9) --------------------------------------------
SAFEVISION_TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
